{
  "name": "opaline",
  "version": "0.1.0",
  "private": true,
  "description": "Liquid glass components for React. Real backdrop refraction, installable with the shadcn CLI.",
  "homepage": "https://opaline.buildlab.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepraj21/opaline"
  },
  "bugs": "https://github.com/deepraj21/opaline/issues",
  "license": "MIT",
  "author": "Abhishek Mallick",
  "keywords": [
    "liquid-glass",
    "glassmorphism",
    "react",
    "tailwindcss",
    "shadcn",
    "shadcn-registry",
    "radix-ui",
    "components",
    "apple"
  ],
  "scripts": {
    "dev": "pnpm registry:gen && next dev",
    "build": "pnpm registry:build && next build",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "registry:gen": "node scripts/generate-registry.mts",
    "registry:build": "pnpm registry:gen && shadcn build",
    "registry:validate": "shadcn registry validate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "katex": "^0.18.9",
    "motion": "^13.4.4",
    "next": "^16.3.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0"
}
